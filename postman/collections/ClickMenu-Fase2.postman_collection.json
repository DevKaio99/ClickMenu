{
  "info": {
    "_postman_id": "a3e2f1c0-4b5d-4a6e-9f7c-clickmenu-fase2",
    "name": "ClickMenu - Fase 2",
    "description": "Collection da API ClickMenu (Tech Challenge Fase 2). Fluxo sugerido: rode a pasta \"Autenticação\" primeiro (captura o token JWT automaticamente), depois \"Tipos de Usuário\", \"Usuários\", \"Restaurantes\" e \"Itens do Cardápio\" nessa ordem - cada requisição de criação guarda o ID retornado em uma variável de coleção, usada automaticamente pelas próximas. A pasta \"Exclusões\" deve ser executada por último, respeitando a ordem (item -> restaurante -> usuário -> tipo), por causa das regras de negócio de cascata.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "tipoDonoRestauranteId", "value": "", "type": "string" },
    { "key": "tipoClienteId", "value": "", "type": "string" },
    { "key": "tipoUsuarioId", "value": "", "type": "string" },
    { "key": "usuarioId", "value": "", "type": "string" },
    { "key": "restauranteId", "value": "", "type": "string" },
    { "key": "itemCardapioId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (admin seed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@email.com\",\n  \"senha\": \"fiap123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Autentica com o usuário ADMIN criado pelo seed (InicializacaoDados) e guarda o token JWT na variável {{token}}, usado por todas as outras requisições (Bearer Token herdado no nível da coleção)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login realizado com sucesso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.token);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Tipos de Usuário",
      "item": [
        {
          "name": "Listar Tipos de Usuário",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tipos-usuario",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tipos-usuario"]
            },
            "description": "Lista todos os tipos de usuário cadastrados. Também captura os IDs dos tipos DONO_RESTAURANTE e CLIENTE (criados pelo seed) nas variáveis {{tipoDonoRestauranteId}} e {{tipoClienteId}}, usados nas pastas seguintes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lista de tipos de usuário retornada\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var tipos = pm.response.json();",
                  "var dono = tipos.find(function (t) { return t.nomeTipo === \"DONO_RESTAURANTE\"; });",
                  "var cliente = tipos.find(function (t) { return t.nomeTipo === \"CLIENTE\"; });",
                  "if (dono) { pm.collectionVariables.set(\"tipoDonoRestauranteId\", dono.id); }",
                  "if (cliente) { pm.collectionVariables.set(\"tipoClienteId\", cliente.id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Criar Tipo de Usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeTipo\": \"CLIENTE_VIP\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tipos-usuario",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tipos-usuario"]
            },
            "description": "Cria um novo tipo de usuário (personalizado, para não colidir com os tipos do seed). Guarda o ID retornado em {{tipoUsuarioId}}, usado pelas requisições de Buscar/Atualizar/Deletar desta pasta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tipo de usuário criado\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"tipoUsuarioId\", jsonData.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Buscar Tipo de Usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tipos-usuario/{{tipoUsuarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tipos-usuario", "{{tipoUsuarioId}}"]
            },
            "description": "Busca o tipo de usuário criado na requisição anterior pelo ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tipo de usuário encontrado\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Atualizar Tipo de Usuário",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeTipo\": \"CLIENTE_VIP_ATUALIZADO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tipos-usuario/{{tipoUsuarioId}}",
